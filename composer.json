{
    "name": "medienreaktor/neos-openapi-bundle",
    "description": "neos/jsonschema, neos/schematic, neos/openapi and neos/openapi-flowadapter in one installable package, until they are released on Packagist.",
    "type": "neos-package",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "neos/flow": "^9.0",
        "psr/http-message": "^1 || ^2",
        "psr/http-server-handler": "^1",
        "psr/http-factory": "^1",
        "psr/container": "^1 || ^2"
    },
    "replace": {
        "neos/jsonschema": "self.version",
        "neos/schematic": "self.version",
        "neos/openapi": "self.version",
        "neos/openapi-flowadapter": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Neos\\OpenApi\\FlowAdapter\\": "Classes/",
            "Neos\\OpenApi\\": "Libraries/openapi/src/",
            "Neos\\Schematic\\": "Libraries/schematic/src/",
            "Neos\\JsonSchema\\": "Libraries/jsonschema/src/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Neos.OpenApi.FlowAdapter"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
